# DeepSeek API key (set in Vercel dashboard, never commit the real value)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Model: deepseek-reasoner (R1) or deepseek-chat (V3, faster)
DEEPSEEK_MODEL=deepseek-reasoner

# Frontend: URL of the Vercel chat API (set in GitHub Actions secrets or .env.local)
VITE_CHAT_API_URL=https://your-vercel-project.vercel.app/api/chat
