# Google Gemini API key (set in Vercel dashboard, never commit the real value)
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model: gemini-2.5-flash (free tier, fast) or gemini-2.5-pro (smarter)
GEMINI_MODEL=gemini-2.5-flash

# Frontend: URL of the Vercel chat API (set in GitHub Actions secrets or .env.local)
VITE_CHAT_API_URL=https://your-vercel-project.vercel.app/api/chat

# Analytics — GoatCounter (free): https://www.goatcounter.com
# Create a site, then use Settings → code snippet → data-goatcounter URL (ends with /count)
VITE_GOATCOUNTER_ENDPOINT=https://kumarsinghaman.goatcounter.com/count

# Upstash Redis (free tier): https://console.upstash.com — stores AI question counts
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Bearer token to read /api/stats and /api/dashboard (top 5 chat questions + traffic)
STATS_SECRET=choose_a_long_random_secret

# GoatCounter API (free) — for the unified Vercel dashboard
# Host is your GoatCounter subdomain root — NOT the /count script URL
GOATCOUNTER_API_HOST=https://kumarsinghaman.goatcounter.com
# Create at GoatCounter → [username] → API
GOATCOUNTER_API_KEY=your_goatcounter_api_key
