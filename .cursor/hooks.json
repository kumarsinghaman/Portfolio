{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-start.cjs"
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/session-end.cjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell-execution-block-no-verify.cjs",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/before-shell-execution.cjs"
      }
    ],
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/after-shell-execution.cjs"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit.cjs"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/before-mcp-execution.cjs"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node .cursor/hooks/after-mcp-execution.cjs"
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/before-read-file.cjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/before-submit-prompt.cjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/subagent-start.cjs"
      }
    ],
    "subagentStop": [
      {
        "command": "node .cursor/hooks/subagent-stop.cjs"
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/before-tab-file-read.cjs"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "node .cursor/hooks/after-tab-file-edit.cjs"
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/pre-compact.cjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop.cjs"
      }
    ]
  }
}
