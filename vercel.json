{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node -e \"console.log('API-only deploy — static portfolio is on GitHub Pages')\"",
  "outputDirectory": "api-public",
  "redirects": [
    {
      "source": "/",
      "destination": "https://kumarsinghaman.github.io/Portfolio/",
      "permanent": false
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
